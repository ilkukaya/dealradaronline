---
import Monogram from '../ui/Monogram.astro';
import Icon from '../ui/Icon.astro';
import OutboundButton from './OutboundButton.astro';
import { getOfferType, getCategory } from '../../config/taxonomy';
import { programStyle } from '../../config/styles';
import { formatDate, formatPriceWithPeriod, getDiscountPercent, getHeadline } from '../../lib/deal-utils';
import type { Deal, Merchant } from '../../lib/catalog';

interface Props {
  deal: Deal;
  merchant: Merchant;
  /** heading level for the title, to keep page outlines valid */
  headingLevel?: 'h2' | 'h3';
}
const { deal, merchant, headingLevel = 'h3' } = Astro.props;
const d = deal.data;
const type = getOfferType(d.offerType);
const category = getCategory(d.category);
const style = programStyle[d.offerType];
const headline = getHeadline(d);
const pct = getDiscountPercent(d);
const Heading = headingLevel;
const href = `/deals/${deal.id}/`;
const search = [d.title, merchant.data.name, d.description, type?.name, category?.name, ...d.tags].join(' ').toLowerCase();
const finePrint = d.restrictions[0];
---

<article
  class="card card-hover group relative flex flex-col p-5"
  data-deal-card
  data-search={search}
  data-merchant={merchant.id}
  data-category={d.category}
  data-type={d.offerType}
  data-price={d.price ?? ''}
  data-discount={pct ?? ''}
  data-published={d.publishedAt.getTime()}
  data-expires={d.endDate?.toISOString()}
  data-expire-action="hide"
>
  <div class="flex items-start gap-3">
    <Monogram name={merchant.data.name} id={merchant.id} size="sm" />
    <div class="min-w-0 flex-1">
      <p class="text-ink truncate text-[0.95rem] font-semibold">{merchant.data.name}</p>
      <p class="text-muted truncate text-xs">{category?.name}</p>
    </div>
    {d.fixture && <span class="pill bg-caution-soft text-caution">Sample data</span>}
  </div>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {pct !== undefined && d.referencePrice !== undefined && <span class="pill bg-accent-strong text-white">{pct}% off</span>}
    {
      type && (
        <span class:list={['pill', style.tint, style.text]}>
          <Icon name={style.icon} class="h-3 w-3" />
          {type.label}
        </span>
      )
    }
  </div>

  <Heading class="display mt-2.5 text-[1.32rem] leading-[1.2] font-medium">
    <a href={href} class="text-ink after:absolute after:inset-0 after:rounded-[var(--radius-card)] hover:underline decoration-1 underline-offset-4" data-track="Deal Click" data-track-props={JSON.stringify({ deal: deal.id })}>
      {d.title}
    </a>
  </Heading>

  <div class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <span class="display tabular text-ink text-[1.9rem] leading-none font-semibold">{headline.value}</span>
    {
      d.referencePrice !== undefined && (
        <span class="text-muted tabular text-sm">
          <span class="sr-only">Regular price </span>
          <s>{formatPriceWithPeriod(d.referencePrice, d.pricePeriod)}</s>
        </span>
      )
    }
  </div>
  {headline.note && <p class="text-muted mt-1 text-sm">{headline.note}</p>}

  {
    finePrint && (
      <div class="bg-shell mt-4 rounded-xl px-3.5 py-3">
        <p class="text-ink flex items-center gap-1.5 text-[0.72rem] font-bold tracking-wide uppercase">
          <Icon name="info" class="text-accent-strong h-3.5 w-3.5" /> Fine print
        </p>
        <p class="text-ink-2 mt-1 line-clamp-3 text-[0.86rem] leading-relaxed">{finePrint}</p>
      </div>
    )
  }

  <div class="mt-auto pt-4">
    <p class="text-positive flex items-center gap-1.5 text-xs font-semibold">
      <Icon name="check-circle" class="h-3.5 w-3.5" /> Checked {formatDate(d.lastVerified)}
    </p>
    <div class="relative z-10 mt-3">
      <OutboundButton deal={deal} merchant={merchant} placement="card" class="!min-h-10 w-full !text-sm sm:w-full" />
    </div>
  </div>
</article>
