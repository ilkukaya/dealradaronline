---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { getCategoriesWithContent, getOfferTypesWithContent } from '../../lib/catalog';
import { programShortName, programStyle } from '../../config/styles';

const path = Astro.url.pathname;
const [cats, programs] = await Promise.all([getCategoriesWithContent(), getOfferTypesWithContent()]);
const nav = [
  { href: '/deals/', label: 'Deals' },
  { href: '/stores/', label: 'Stores' },
  { href: '/discounts/', label: 'Discounts' },
  { href: '/guides/', label: 'Guides' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
const chips = [
  ...programs.map((p) => ({ href: `/discounts/${p.slug}/`, label: programShortName[p.slug], icon: programStyle[p.slug].icon, track: `program:${p.slug}` })),
  ...cats.map((c) => ({ href: `/categories/${c.slug}/`, label: c.name, icon: c.icon, track: c.slug })),
];
---

<aside aria-label="Affiliate disclosure" class="bg-shell text-ink-2 border-line border-b text-[0.8rem]">
  <p class="container-page flex items-center justify-center gap-2 py-2 text-center">
    <span class="bg-accent hidden h-1.5 w-1.5 shrink-0 rounded-full sm:inline-block" aria-hidden="true"></span>
    <span>
      Independent and reader-supported. We may earn a commission from some links, at no cost to you.{' '}
      <a href="/affiliate-disclosure/" class="text-accent-deep font-semibold whitespace-nowrap underline underline-offset-2">How this works →</a>
    </span>
  </p>
</aside>

<header class="sticky top-0 z-40 bg-white/95 shadow-[0_1px_8px_rgba(14,26,53,0.05)] backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-page flex h-16 items-center gap-4 lg:h-[4.5rem]">
    <a href="/" class="-ml-1 shrink-0 rounded-lg p-1 no-underline" aria-label="Home">
      <Logo />
    </a>

    <nav aria-label="Main" class="ml-4 hidden h-full md:block">
      <ul class="flex h-full items-center gap-1">
        {
          nav.map((item) => (
            <li class="h-full">
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="text-ink-2 hover:text-ink aria-[current=page]:text-accent-deep aria-[current=page]:border-accent-strong flex h-full items-center border-b-2 border-transparent px-3 text-[0.95rem] font-semibold no-underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <form action="/deals/" method="get" role="search" aria-label="Site search" class="ml-auto hidden w-full max-w-sm lg:block">
      <label for="header-search" class="sr-only">Search deals and stores</label>
      <div class="relative">
        <Icon name="search" class="text-faint pointer-events-none absolute top-1/2 left-3.5 h-4.5 w-4.5 -translate-y-1/2" />
        <input
          id="header-search"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Search deals and stores…"
          class="bg-shell focus:ring-ink/20 placeholder:text-faint h-11 w-full rounded-full border border-transparent pr-4 pl-10 text-[0.95rem] outline-none focus:bg-white focus:ring-2"
        />
      </div>
    </form>

    <a href="/newsletter/" class="btn-primary ml-auto hidden !min-h-10 !px-4 !text-sm md:inline-flex lg:ml-2">
      <Icon name="mail" class="h-4 w-4" /> Get updates
    </a>

    <details class="group ml-auto md:hidden" data-mobile-menu>
      <summary class="bg-shell text-ink flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full [&::-webkit-details-marker]:hidden" aria-label="Open menu">
        <Icon name="menu" class="h-5 w-5 group-open:hidden" />
        <Icon name="close" class="hidden h-5 w-5 group-open:block" />
      </summary>
      <div class="border-line shadow-float absolute inset-x-0 top-full max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-b bg-white px-4 pt-4 pb-8">
        <form action="/deals/" method="get" role="search" aria-label="Mobile site search" class="mb-5">
          <label for="mobile-search" class="sr-only">Search deals and stores</label>
          <div class="relative">
            <Icon name="search" class="text-faint pointer-events-none absolute top-1/2 left-3.5 h-5 w-5 -translate-y-1/2" />
            <input id="mobile-search" name="q" type="search" placeholder="Search deals and stores…" class="field rounded-full pl-11" />
          </div>
        </form>
        <nav aria-label="Mobile">
          <ul class="divide-line divide-y">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="display text-ink flex items-center justify-between py-3.5 text-2xl font-semibold no-underline">
                    {item.label} <Icon name="arrow" class="text-faint h-4 w-4" />
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/newsletter/" class="text-accent-deep flex items-center justify-between py-3.5 text-lg font-semibold no-underline">
                Get email updates <Icon name="mail" class="h-5 w-5" />
              </a>
            </li>
          </ul>
        </nav>
        {
          chips.length > 0 && (
            <div class="mt-6">
              <p class="eyebrow mb-3">Browse</p>
              <div class="flex flex-wrap gap-2">
                {chips.map((c) => (
                  <a href={c.href} class="chip">
                    <Icon name={c.icon} class="h-4 w-4" />
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </details>
  </div>

  {
    chips.length > 0 && (
      <nav aria-label="Categories" class="border-line/70 hidden border-t md:block">
        <ul class="container-page flex items-center gap-2 overflow-x-auto py-2.5 whitespace-nowrap [scrollbar-width:none]">
          {chips.map((c) => (
            <li>
              <a
                href={c.href}
                data-track="Category Select"
                data-track-props={JSON.stringify({ category: c.track })}
                aria-current={path === c.href ? 'page' : undefined}
                class="chip !min-h-8 !px-3 !text-[0.78rem]"
              >
                <Icon name={c.icon} class="h-3.5 w-3.5" />
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>
