---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { getCategoriesWithContent, getOfferTypesWithContent } from '../../lib/catalog';

const path = Astro.url.pathname;
const [cats, programs] = await Promise.all([getCategoriesWithContent(), getOfferTypesWithContent()]);
const nav = [
  { href: '/deals/', label: 'Deals' },
  { href: '/stores/', label: 'Stores' },
  { href: '/discounts/', label: 'Discounts' },
  { href: '/guides/', label: 'Guides' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<div class="bg-ink text-[0.8rem] text-white/85">
  <p class="container-page py-2 text-center">
    Independent and reader-supported. We may earn a commission from some links, at no cost to you.{' '}
    <a href="/affiliate-disclosure/" class="font-semibold whitespace-nowrap text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">
      How this works
    </a>
  </p>
</div>

<header class="border-line sticky top-0 z-40 border-b bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-page flex h-16 items-center gap-4">
    <a href="/" class="-ml-1 rounded-lg p-1 no-underline" aria-label="Home">
      <Logo />
    </a>

    <nav aria-label="Main" class="ml-6 hidden md:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="text-ink-2 hover:bg-canvas hover:text-ink aria-[current=page]:text-ink rounded-full px-3.5 py-2 text-[0.95rem] font-medium no-underline aria-[current=page]:font-semibold"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <form action="/deals/" method="get" role="search" class="ml-auto hidden w-full max-w-xs lg:block">
      <label for="header-search" class="sr-only">Search deals and stores</label>
      <div class="relative">
        <Icon name="search" class="text-faint pointer-events-none absolute top-1/2 left-3.5 h-4.5 w-4.5 -translate-y-1/2" />
        <input
          id="header-search"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Search deals and stores"
          class="border-line bg-canvas focus:border-ink placeholder:text-faint h-10 w-full rounded-full border pr-4 pl-10 text-[0.95rem] outline-none focus:bg-white"
        />
      </div>
    </form>

    <a href="/newsletter/" class="btn-primary ml-auto hidden !min-h-10 !px-4 !text-sm md:inline-flex lg:ml-2">
      <Icon name="mail" class="h-4 w-4" /> Get updates
    </a>

    <details class="group ml-auto md:hidden" data-mobile-menu>
      <summary class="border-line text-ink flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border [&::-webkit-details-marker]:hidden" aria-label="Open menu">
        <Icon name="menu" class="h-5 w-5 group-open:hidden" />
        <Icon name="close" class="hidden h-5 w-5 group-open:block" />
      </summary>
      <div class="border-line shadow-lift absolute inset-x-0 top-full max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-b bg-white px-4 pt-4 pb-8">
        <form action="/deals/" method="get" role="search" class="mb-5">
          <label for="mobile-search" class="sr-only">Search deals and stores</label>
          <div class="relative">
            <Icon name="search" class="text-faint pointer-events-none absolute top-1/2 left-3.5 h-5 w-5 -translate-y-1/2" />
            <input id="mobile-search" name="q" type="search" placeholder="Search deals and stores" class="field pl-11" />
          </div>
        </form>
        <nav aria-label="Mobile">
          <ul class="divide-line divide-y">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="text-ink flex items-center justify-between py-3.5 text-lg font-semibold no-underline">
                    {item.label} <Icon name="arrow" class="text-faint h-4 w-4" />
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/newsletter/" class="text-accent-strong flex items-center justify-between py-3.5 text-lg font-semibold no-underline">
                Get email updates <Icon name="mail" class="h-5 w-5" />
              </a>
            </li>
          </ul>
        </nav>
        {
          cats.length > 0 && (
            <div class="mt-6">
              <p class="eyebrow mb-3">Categories</p>
              <div class="flex flex-wrap gap-2">
                {cats.map((c) => (
                  <a href={`/categories/${c.slug}/`} class="chip">
                    {c.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </details>
  </div>

  {
    (cats.length > 0 || programs.length > 0) && (
      <nav aria-label="Categories" class="border-line hidden border-t md:block">
        <ul class="container-page flex h-11 items-center gap-1 overflow-x-auto text-sm whitespace-nowrap [scrollbar-width:none]">
          {programs.map((p) => (
            <li>
              <a
                href={`/discounts/${p.slug}/`}
                data-track="Category Select"
                data-track-props={JSON.stringify({ category: `program:${p.slug}` })}
                aria-current={path === `/discounts/${p.slug}/` ? 'page' : undefined}
                class="text-muted hover:text-ink aria-[current=page]:text-ink rounded-md px-2.5 py-1.5 font-medium no-underline aria-[current=page]:font-semibold"
              >
                {p.name.replace('Discounts for Government Assistance Recipients', 'Assistance Discounts')}
              </a>
            </li>
          ))}
          {programs.length > 0 && cats.length > 0 && (
            <li aria-hidden="true" class="bg-line mx-2 h-4 w-px" />
          )}
          {cats.map((c) => (
            <li>
              <a
                href={`/categories/${c.slug}/`}
                data-track="Category Select"
                data-track-props={JSON.stringify({ category: c.slug })}
                aria-current={path === `/categories/${c.slug}/` ? 'page' : undefined}
                class="text-muted hover:text-ink aria-[current=page]:text-ink rounded-md px-2.5 py-1.5 font-medium no-underline aria-[current=page]:font-semibold"
              >
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>
