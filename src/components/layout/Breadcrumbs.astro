---
import { absoluteUrl } from '../../config/site';
import JsonLd from '../seo/JsonLd.astro';

export interface Crumb {
  name: string;
  href: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const all: Crumb[] = [{ name: 'Home', href: '/' }, ...items];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: absoluteUrl(c.href),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-muted text-sm">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {
      all.map((c, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && (
            <span aria-hidden="true" class="text-faint">
              /
            </span>
          )}
          {i === all.length - 1 ? (
            <span aria-current="page" class="text-ink-2 line-clamp-1">
              {c.name}
            </span>
          ) : (
            <a href={c.href} class="hover:text-ink underline-offset-2 hover:underline">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd data={schema} />
