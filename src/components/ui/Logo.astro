---
import { site } from '../../config/site';

interface Props {
  /** "full" shows mark + wordmark; "mark" shows only the radar mark. */
  variant?: 'full' | 'mark';
  class?: string;
  inverted?: boolean;
}
const { variant = 'full', class: className = '', inverted = false } = Astro.props;
const ink = inverted ? '#ffffff' : '#0e1a35';
// Split the configurable brand name so the last word ("Online") is set smaller.
const words = site.name.split(' ');
const primary = words.length > 1 ? words.slice(0, -1).join(' ') : site.name;
const secondary = words.length > 1 ? words[words.length - 1] : '';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true" focusable="false" class="shrink-0">
    <circle cx="20" cy="20" r="18" fill="none" stroke={ink} stroke-width="2.4"></circle>
    <circle cx="20" cy="20" r="11.5" fill="none" stroke={ink} stroke-width="1.6" opacity="0.35"></circle>
    <path d="M20 20 L20 2 A18 18 0 0 1 35.6 11 Z" fill="#f0603c" opacity="0.9"></path>
    <circle cx="20" cy="20" r="2.6" fill={ink}></circle>
    <circle cx="28.5" cy="9.8" r="2.4" fill={ink}></circle>
  </svg>
  {
    variant === 'full' && (
      <span class="flex items-baseline gap-1 leading-none">
        <span class="display text-[1.35rem] font-semibold tracking-tight" style={`color:${ink}`}>
          {primary}
        </span>
        {secondary && (
          <span class="text-[0.7rem] font-semibold tracking-[0.14em] uppercase" style={`color:${inverted ? '#fbd5c7' : '#c8401a'}`}>
            {secondary}
          </span>
        )}
      </span>
    )
  }
</span>
