---
/**
 * Store mark: the store's logo on a white tile (inline SVG from
 * src/lib/brand-logos.ts, so no extra requests). Stores without a logo entry
 * fall back to initials on a soft tile.
 */
import { brandLogos } from '../../lib/brand-logos';

interface Props {
  name: string;
  /** Merchant id; defaults to the slugified name ("The Home Depot" → home-depot). */
  id?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  /** Fallback only: "soft" tinted tile (default) or "solid" navy tile. */
  tone?: 'soft' | 'solid';
}
const { name, id, size = 'md', tone = 'soft' } = Astro.props;
const clean = name.replace(/^The\s+/i, '').replace(/[^A-Za-z0-9 ]/g, '');
const logo = brandLogos[id ?? clean.toLowerCase().replace(/\s+/g, '-')];
const parts = clean.split(/\s+/).filter(Boolean);
const capitals = clean.replace(/[^A-Z]/g, '');
// "Best Buy" → BB, "GitHub" → GH, "YouTube" → YT, "Nike" → NI
const initials = (parts.length > 1 ? parts[0]![0]! + parts[1]![0]! : capitals.length >= 2 ? capitals.slice(0, 2) : clean.slice(0, 2)).toUpperCase();
const palettes = [
  'bg-navy-soft text-ink',
  'bg-accent-soft text-accent-deep',
  'bg-sand text-ink-2',
  'bg-positive-soft text-positive',
  'bg-caution-soft text-caution',
];
let hash = 0;
for (const ch of clean) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const palette = tone === 'solid' ? 'bg-ink text-white' : palettes[hash % palettes.length];
const sizes = {
  xs: 'h-7 w-7 text-[0.7rem] rounded-md',
  sm: 'h-10 w-10 text-[0.95rem] rounded-lg',
  md: 'h-12 w-12 text-lg rounded-xl',
  lg: 'h-16 w-16 text-2xl rounded-2xl',
};
---

{
  logo ? (
    <span class:list={['inline-flex shrink-0 items-center justify-center overflow-hidden bg-white shadow-[0_1px_2px_rgba(14,26,53,0.1)]', sizes[size], logo.fill < 100 && 'ring-line ring-1 ring-inset']} aria-hidden="true">
      <svg viewBox={logo.viewBox} style={`width:${logo.fill}%;height:${logo.fill}%`} preserveAspectRatio={logo.fill < 100 ? 'xMidYMid meet' : 'xMidYMid slice'} focusable="false" set:html={logo.body} />
    </span>
  ) : (
    <span class:list={['display inline-flex shrink-0 items-center justify-center font-semibold', sizes[size], palette]} aria-hidden="true">
      {initials}
    </span>
  )
}
