---
/** Layout for editorial and legal pages: title, optional dek and date, prose body. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { formatDate } from '../lib/deal-utils';

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  dek?: string;
  updated?: Date;
  path: string;
  noindex?: boolean;
  wide?: boolean;
}
const { title, metaTitle, description, dek, updated, path, noindex = false, wide = false } = Astro.props;
---

<BaseLayout title={metaTitle ?? title} description={description} canonicalPath={path} noindex={noindex}>
  <div class="border-line border-b bg-white">
    <div class="container-page py-8 sm:py-12">
      <Breadcrumbs items={[{ name: title, href: path }]} />
      <h1 class="display mt-5 max-w-3xl text-4xl leading-tight font-semibold sm:text-5xl">{title}</h1>
      {dek && <p class="text-ink-2 mt-4 max-w-2xl text-xl leading-relaxed">{dek}</p>}
      {updated && <p class="text-muted mt-4 text-sm">Last updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></p>}
    </div>
  </div>
  <div class="container-page py-10">
    <div class:list={['prose-editorial', wide ? 'max-w-4xl' : 'max-w-3xl']}>
      <slot />
    </div>
    <slot name="after" />
  </div>
</BaseLayout>
