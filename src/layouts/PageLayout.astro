---
/** Layout for editorial and legal pages: title, optional dek and date, prose body. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { formatDate } from '../lib/deal-utils';

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  dek?: string;
  updated?: Date;
  path: string;
  noindex?: boolean;
  wide?: boolean;
}
const { title, metaTitle, description, dek, updated, path, noindex = false, wide = false } = Astro.props;
---

<BaseLayout title={metaTitle ?? title} description={description} canonicalPath={path} noindex={noindex}>
  <div class="bg-shell">
    <div class="container-page pt-7 pb-12">
      <Breadcrumbs items={[{ name: title, href: path }]} />
      <h1 class="display mt-6 max-w-3xl text-[2.6rem] leading-[1.05] font-semibold sm:text-[3.4rem]">{title}</h1>
      {dek && <p class="text-ink-2 mt-4 max-w-2xl text-xl leading-relaxed">{dek}</p>}
      {updated && <p class="text-muted mt-5 inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-sm">Last updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></p>}
    </div>
  </div>
  <div class="container-page py-10">
    <div class:list={['card prose-editorial p-6 sm:p-10', wide ? 'max-w-4xl' : 'max-w-3xl']}>
      <slot />
    </div>
    <slot name="after" />
  </div>
</BaseLayout>
