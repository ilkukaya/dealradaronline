---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import StoreCard from '../../components/ui/StoreCard.astro';
import { getActiveDeals, getPublishedMerchants } from '../../lib/catalog';

const [merchants, active] = await Promise.all([getPublishedMerchants(), getActiveDeals()]);
const rows = merchants.map((m) => ({ merchant: m, count: active.filter((d) => d.data.merchant === m.id).length }));
---

<BaseLayout
  title="Stores: Deals, Discounts & Policies by Retailer"
  description="Browse the US stores we cover. Each store page lists active offers, shipping and return policies with sources, and practical shopping tips."
  canonicalPath="/stores/"
>
  <div class="border-line border-b bg-white">
    <div class="container-page py-8 sm:py-10">
      <Breadcrumbs items={[{ name: 'Stores', href: '/stores/' }]} />
      <h1 class="display mt-4 text-4xl font-semibold">Stores</h1>
      <p class="text-ink-2 mt-3 max-w-2xl text-lg leading-relaxed">
        The retailers and services we currently cover. Each page collects active offers along with the store's shipping and return rules, linked to the store's own policy pages.
      </p>
    </div>
  </div>
  <div class="container-page py-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {rows.map((r) => <StoreCard merchant={r.merchant} offerCount={r.count} headingLevel="h2" />)}
    </div>
    <p class="text-muted mt-10 max-w-3xl text-sm leading-relaxed">
      Listing a store does not mean it endorses or sponsors us. Store names are trademarks of their owners. Want your store covered? See <a href="/partners/" class="link">Work with us</a>.
    </p>
  </div>
</BaseLayout>
