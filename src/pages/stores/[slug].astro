---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import DealCard from '../../components/deals/DealCard.astro';
import StoreLink from '../../components/deals/StoreLink.astro';
import GuideCard from '../../components/ui/GuideCard.astro';
import Monogram from '../../components/ui/Monogram.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCategory } from '../../config/taxonomy';
import { getDealsForMerchant, getGuides, getPublishedMerchants, isActive, isStoreIndexable, merchantHasApprovedProgram, type Merchant } from '../../lib/catalog';
import { formatDate } from '../../lib/deal-utils';

export async function getStaticPaths() {
  const merchants = await getPublishedMerchants();
  return merchants.map((merchant) => ({ params: { slug: merchant.id }, props: { merchant } }));
}

const { merchant } = Astro.props as { merchant: Merchant };
const md = merchant.data;
const deals = await getDealsForMerchant(merchant.id);
const active = deals.filter(isActive);
const ended = deals.filter((d) => !isActive(d));
const guides = (await getGuides()).filter((g) => g.data.relatedStores.includes(merchant.id));
const generalGuides = guides.length ? guides : (await getGuides()).filter((g) => ['how-to-check-a-return-policy', 'compare-final-prices-shipping-tax'].includes(g.id));
const affiliate = merchantHasApprovedProgram(merchant);
const overview = md.overview.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const title = active.length > 0 ? `${md.name} Deals, Discounts & Store Policies` : `${md.name} Shipping, Returns & Shopping Tips`;
const description = active.length > 0
  ? `${active.length} active ${md.name} ${active.length === 1 ? 'offer' : 'offers'}, plus ${md.name}'s shipping and return policies with sources and when we last checked them.`
  : `${md.name}'s shipping and return policies with sources, and practical tips for shopping at ${md.domain}.`;
---

<BaseLayout title={title} description={description.slice(0, 160)} canonicalPath={`/stores/${merchant.id}/`} noindex={!isStoreIndexable(merchant, active.length)}>
  <div class="border-line border-b bg-white">
    <div class="container-page py-8 sm:py-10">
      <Breadcrumbs items={[{ name: 'Stores', href: '/stores/' }, { name: md.name, href: `/stores/${merchant.id}/` }]} />
      <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
          <Monogram name={md.name} size="lg" />
          <div>
            <h1 class="display text-3xl font-semibold sm:text-4xl">{md.name} deals &amp; policies</h1>
            <p class="text-ink-2 mt-1.5 max-w-2xl">{md.tagline}</p>
          </div>
        </div>
        <StoreLink merchant={merchant} placement="store-header" class="btn-ghost shrink-0" />
      </div>
      <p class="text-muted mt-5 flex items-start gap-2 text-sm">
        <Icon name="info" class="mt-0.5 h-4 w-4 shrink-0" />
        <span>
          {affiliate
            ? `We may earn a commission when you buy from ${md.name} through some links on this page, at no extra cost to you.`
            : `We don't currently earn a commission from ${md.name}. Links on this page go directly to ${md.domain}.`}{' '}
          {md.name} has not reviewed or endorsed this page. <a href="/affiliate-disclosure/" class="underline underline-offset-2">Disclosure</a>
        </span>
      </p>
    </div>
  </div>

  <div class="container-page py-10">
    <section aria-labelledby="offers">
      <h2 id="offers" class="display text-2xl font-semibold">
        {active.length > 0 ? `Active ${md.name} offers (${active.length})` : `No active ${md.name} offers right now`}
      </h2>
      {
        active.length > 0 ? (
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {active.map((d) => <DealCard deal={d} merchant={merchant} />)}
          </div>
        ) : (
          <p class="text-ink-2 mt-3 max-w-2xl">
            We haven't confirmed a current offer from {md.name}. The store information below is still current as of the dates shown. Browse <a href="/deals/" class="link">all active deals</a> instead.
          </p>
        )
      }
    </section>

    <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_380px]">
      <div class="min-w-0">
        <section aria-labelledby="about-store">
          <h2 id="about-store" class="display text-2xl font-semibold">About shopping at {md.name}</h2>
          <div class="prose-editorial mt-3">{overview.map((p) => <p>{p}</p>)}</div>
        </section>

        {
          md.tips.length > 0 && (
            <section class="mt-10" aria-labelledby="tips">
              <h2 id="tips" class="display text-2xl font-semibold">Tips for saving at {md.name}</h2>
              <ul class="mt-4 space-y-3">
                {md.tips.map((t) => (
                  <li class="text-ink-2 flex gap-3 leading-relaxed">
                    <Icon name="check" class="text-positive mt-1 h-4.5 w-4.5 shrink-0" />
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="lg:self-start" aria-labelledby="policies">
        <div class="card p-5 sm:p-6">
          <h2 id="policies" class="text-ink font-semibold">Store policies at a glance</h2>
          {
            md.facts.length > 0 ? (
              <dl class="divide-line mt-3 divide-y">
                {md.facts.map((f) => (
                  <div class="py-4">
                    <dt class="text-ink text-sm font-semibold">{f.label}</dt>
                    <dd class="text-ink-2 mt-1 text-sm leading-relaxed">
                      {f.value}
                      <span class="text-muted mt-1.5 block text-xs">
                        Source: <a href={f.sourceUrl} rel="nofollow noopener" target="_blank" class="underline underline-offset-2">{new URL(f.sourceUrl).host.replace(/^www\./, '')}</a> · checked {formatDate(f.checkedAt)}
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="text-ink-2 mt-3 text-sm">We haven't summarized {md.name}'s policies yet. Check the store's help pages before you buy.</p>
            )
          }
          <p class="text-muted border-line mt-2 border-t pt-4 text-xs leading-relaxed">Policies change. The store's own terms at checkout always apply.</p>
        </div>
        <p class="text-muted mt-4 text-sm">
          Categories: {md.categories.map((c, i) => <>{i > 0 && ', '}<span>{getCategory(c)?.name}</span></>)}
        </p>
      </aside>
    </div>

    {
      ended.length > 0 && (
        <section class="mt-14" aria-labelledby="ended">
          <h2 id="ended" class="text-ink text-lg font-semibold">Ended offers</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {ended.map((d) => (
              <li>
                <a href={`/deals/${d.id}/`} class="text-muted hover:text-ink hover:underline">{d.data.title}</a>{' '}
                <span class="text-faint">{d.data.endDate ? `(ended ${formatDate(d.data.endDate)})` : '(ended)'}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      generalGuides.length > 0 && (
        <section class="mt-14" aria-labelledby="guides">
          <h2 id="guides" class="display text-2xl font-semibold">Helpful guides</h2>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {generalGuides.slice(0, 3).map((g) => <GuideCard guide={g} />)}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
