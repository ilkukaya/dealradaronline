---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import GuideCard from '../../components/ui/GuideCard.astro';
import DealCard from '../../components/deals/DealCard.astro';
import NewsletterForm from '../../components/forms/NewsletterForm.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Icon from '../../components/ui/Icon.astro';
import ShareLinks from '../../components/ui/ShareLinks.astro';
import { ogImageFor, pinImageFor } from '../../lib/og';
import { absoluteUrl, site } from '../../config/site';
import { getActiveDeals, getGuides, getMerchantMap, readingMinutes, type Guide } from '../../lib/catalog';
import { formatDate } from '../../lib/deal-utils';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const g = guide.data;
const { Content, headings } = await render(guide);
const toc = headings.filter((h) => h.depth === 2);
const all = await getGuides();
const related = [
  ...g.relatedGuides.map((id) => all.find((x) => x.id === id)).filter((x): x is Guide => Boolean(x)),
  ...all.filter((x) => x.id !== guide.id && !g.relatedGuides.includes(x.id)),
].slice(0, 3);
const merchants = await getMerchantMap();
const deals = (await getActiveDeals()).filter((d) => g.relatedOfferTypes.includes(d.data.offerType) || g.relatedStores.includes(d.data.merchant)).slice(0, 3);
const modified = g.updatedAt ?? g.publishedAt;
const url = absoluteUrl(`/guides/${guide.id}/`);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.title,
  description: g.description,
  datePublished: g.publishedAt.toISOString(),
  dateModified: modified.toISOString(),
  mainEntityOfPage: url,
  image: absoluteUrl(ogImageFor('guides', guide.id)),
  inLanguage: 'en-US',
  author: { '@type': 'Organization', name: `${site.name} editors`, url: absoluteUrl('/about/') },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: absoluteUrl('/icon-512.png') } },
};
---

<BaseLayout title={g.title} description={g.description} canonicalPath={`/guides/${guide.id}/`} type="article" publishedTime={g.publishedAt} modifiedTime={modified} image={ogImageFor('guides', guide.id)}>
  <JsonLd slot="head" data={articleLd} />
  <div class="container-page pt-7 pb-10">
    <Breadcrumbs items={[{ name: 'Guides', href: '/guides/' }, { name: g.title, href: `/guides/${guide.id}/` }]} />
    <div class="max-w-4xl">
      <p class="mt-6 flex flex-wrap items-center gap-2">
        <span class="pill bg-accent-soft text-accent-deep">Shopping guide{g.tags[0] ? ` · ${g.tags[0]}` : ''}</span>
      </p>
      <h1 class="display mt-4 text-[2.4rem] leading-[1.05] font-semibold sm:text-[3.6rem]">{g.title}</h1>
      <p class="text-ink-2 mt-5 max-w-3xl text-xl leading-relaxed">{g.summary}</p>
    </div>
    <div class="border-line mt-8 flex flex-col gap-4 border-y py-4 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <span class="bg-ink display flex h-11 w-11 items-center justify-center rounded-full text-sm font-semibold text-white" aria-hidden="true">DR</span>
        <div>
          <p class="text-ink text-sm font-semibold">{site.name} editors</p>
          <p class="text-muted text-sm">
            {g.updatedAt ? 'Updated' : 'Published'} <time datetime={modified.toISOString()}>{formatDate(modified)}</time> · {readingMinutes(guide.body)} min read
          </p>
        </div>
      </div>
      <ShareLinks path={`/guides/${guide.id}/`} title={g.title} pinImage={pinImageFor(guide.id) ?? ogImageFor('guides', guide.id)} />
    </div>
  </div>

  <div class="container-page grid gap-12 pb-10 lg:grid-cols-[minmax(0,1fr)_300px]">
    <article class="prose-editorial guide-body max-w-3xl min-w-0">
      <Content />
    </article>
    <aside class="hidden lg:block">
      {
        toc.length > 2 && (
          <nav aria-label="On this page" class="card sticky top-36 p-5">
            <p class="flex items-center justify-between text-[0.72rem] font-bold tracking-[0.12em] uppercase">
              <span class="text-ink">On this page</span>
              <span class="text-accent-deep">{toc.length} sections</span>
            </p>
            <ol class="mt-4 space-y-2.5 text-sm">
              {toc.map((h, i) => (
                <li class="flex gap-3">
                  <span class="text-faint tabular font-mono text-xs leading-5">{String(i + 1).padStart(2, '0')}</span>
                  <a href={`#${h.slug}`} class="text-ink-2 hover:text-ink leading-5 hover:underline">{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </div>

  <div class="container-page">
    <div class="bg-navy-soft max-w-3xl rounded-[var(--radius-card)] p-5 text-sm leading-relaxed sm:p-6">
      <p class="text-ink flex items-center gap-2 font-semibold"><Icon name="shield" class="h-5 w-5" /> About this guide</p>
      <p class="text-ink-2 mt-2">
        Written by the {site.name} editors for general information only — it isn't legal or financial advice. Store policies vary and change; check the store's current terms before you buy. See our <a href="/editorial-policy/" class="link">editorial policy</a>.
      </p>
    </div>

    {
      deals.length > 0 && (
        <section class="mt-14" aria-labelledby="deals">
          <h2 id="deals" class="display text-[2rem] font-semibold">Offers mentioned in this guide</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {deals.map((d) => <DealCard deal={d} merchant={merchants.get(d.data.merchant)!} />)}
          </div>
        </section>
      )
    }

    <section class="mt-14" aria-labelledby="more">
      <h2 id="more" class="display text-[2rem] font-semibold">Keep reading</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {related.map((r) => <GuideCard guide={r} />)}
      </div>
    </section>

    <section class="card mt-14 grid gap-6 p-6 sm:p-8 lg:grid-cols-2 lg:items-center" aria-labelledby="nl">
      <div>
        <h2 id="nl" class="display text-2xl font-semibold">Get new guides and checked offers by email</h2>
        <p class="text-ink-2 mt-2">One short email, no daily blasts.</p>
      </div>
      <NewsletterForm variant="inline" idPrefix="guide-nl" />
    </section>
  </div>
</BaseLayout>
