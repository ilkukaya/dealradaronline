---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureDealCard from '../components/deals/FeatureDealCard.astro';
import DealRow from '../components/deals/DealRow.astro';
import GuideCard from '../components/ui/GuideCard.astro';
import Monogram from '../components/ui/Monogram.astro';
import Icon from '../components/ui/Icon.astro';
import NewsletterForm from '../components/forms/NewsletterForm.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import AdSlot from '../components/integrations/AdSlot.astro';
import { absoluteUrl, site } from '../config/site';
import { programShortName, programStyle } from '../config/styles';
import { getActiveDeals, getCategoriesWithContent, getGuides, getMerchantMap, getOfferTypesWithContent, getPublishedMerchants } from '../lib/catalog';
import { formatDate, getHeadline } from '../lib/deal-utils';

const [active, merchantMap, merchants, cats, programs, guides] = await Promise.all([
  getActiveDeals(),
  getMerchantMap(),
  getPublishedMerchants(),
  getCategoriesWithContent(),
  getOfferTypesWithContent(),
  getGuides(),
]);
const m = (id: string) => merchantMap.get(id)!;

const featured = active.filter((d) => d.data.featured).slice(0, 4);
const featuredIds = new Set(featured.map((d) => d.id));
const recent = active.filter((d) => !featuredIds.has(d.id)).slice(0, 6);
const recentTypes = programs.filter((p) => recent.some((d) => d.data.offerType === p.slug));
const picks = active.filter((d) => d.data.editorsPick).slice(0, 3);
const blips = (featured.length ? featured : active).slice(0, 3);
const latestCheck = active.length ? new Date(Math.max(...active.map((d) => d.data.lastVerified.getTime()))) : undefined;
const storeRows = merchants
  .map((mm) => ({ merchant: mm, count: active.filter((d) => d.data.merchant === mm.id).length }))
  .filter((s) => s.count > 0)
  .sort((a, b) => b.count - a.count || a.merchant.data.name.localeCompare(b.merchant.data.name))
  .slice(0, 11);
const storesWithOffers = merchants.filter((mm) => active.some((d) => d.data.merchant === mm.id)).length;
const programStores = (slug: string) => [...new Set(active.filter((d) => d.data.offerType === slug).map((d) => m(d.data.merchant).data.name))];
const firstParagraph = (s: string) => s.split(/\n\s*\n/)[0]?.trim() ?? s;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: `${site.url}/`,
    logo: absoluteUrl('/icon-512.png'),
    description: site.description,
    sameAs: Object.values(site.social).filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    url: `${site.url}/`,
    inLanguage: 'en-US',
    publisher: { '@id': `${site.url}/#organization` },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site.url}/deals/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description="Independent US deal discovery: student and military discounts, free trials, free shipping, and promo codes — with restrictions and last-checked dates."
  canonicalPath="/"
>
  <JsonLd slot="head" data={jsonLd} />

  <!-- Hero -->
  <section class="container-page grid gap-10 py-10 sm:py-14 lg:grid-cols-12 lg:items-center lg:gap-12">
    <div class="lg:col-span-7">
      <p class="bg-accent-soft text-accent-deep inline-flex items-center gap-2 rounded-full px-3 py-1 text-[0.72rem] font-bold tracking-[0.1em] uppercase">
        <span class="bg-accent-strong h-2 w-2 rounded-full"></span> Independent US deal discovery
      </p>
      <h1 class="display mt-5 text-[2.6rem] leading-[1.05] font-semibold sm:text-[3.6rem] lg:text-[4rem]">
        Real savings, with the <em class="text-accent-strong font-medium">fine print</em> up front.
      </h1>
      <p class="text-ink-2 mt-5 max-w-xl text-lg leading-relaxed">
        We track student and military pricing, discounts for people on government assistance, free trials, and store shipping rules — and write down who qualifies and what the catch is.
      </p>
      <form action="/deals/" method="get" role="search" aria-label="Search deals" class="mt-7 max-w-xl">
        <label for="hero-search" class="sr-only">Search deals and stores</label>
        <div class="focus-within:ring-ink/15 flex items-center gap-2 rounded-full bg-white p-1.5 pl-5 shadow-[0_2px_14px_rgba(14,26,53,0.08)] focus-within:ring-2">
          <Icon name="search" class="text-faint h-5 w-5 shrink-0" />
          <input id="hero-search" name="q" type="search" placeholder="Try “student”, “Target” or “free shipping”" class="placeholder:text-faint min-w-0 flex-1 bg-transparent py-2.5 text-base outline-none" />
          <button type="submit" class="btn-dark !min-h-11 shrink-0 !px-5">Search <Icon name="arrow" class="hidden h-4 w-4 sm:block" /></button>
        </div>
      </form>
      {
        programs.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="text-faint mr-1 text-[0.7rem] font-bold tracking-[0.12em] uppercase">Jump to</span>
            {programs.map((p) => (
              <a href={`/discounts/${p.slug}/`} class:list={['chip !min-h-8 !px-3 !text-[0.8rem]', programStyle[p.slug].tint, programStyle[p.slug].text]} data-track="Category Select" data-track-props={JSON.stringify({ category: `program:${p.slug}`, placement: 'hero' })}>
                <Icon name={programStyle[p.slug].icon} class="h-3.5 w-3.5" />
                {programShortName[p.slug]}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <!-- Radar panel: real offers only -->
    {
      blips.length > 0 && (
        <div class="lg:col-span-5">
          <div class="shadow-float relative mx-auto flex aspect-[1/1.02] w-full max-w-[460px] flex-col justify-between overflow-hidden rounded-[28px] bg-white p-5 sm:p-6">
            <div class="relative z-10 flex items-center justify-between">
              <p class="text-ink flex items-center gap-2 text-[0.72rem] font-bold tracking-[0.1em] uppercase">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="bg-accent absolute inline-flex h-full w-full animate-ping rounded-full opacity-60 motion-reduce:animate-none" />
                  <span class="bg-accent-strong relative inline-flex h-2.5 w-2.5 rounded-full" />
                </span>
                On the radar
              </p>
              <span class="bg-shell text-ink-2 rounded-full px-2.5 py-0.5 text-xs font-semibold">{active.length} active offers</span>
            </div>
            <div class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
              {[24, 48, 72, 96].map((s) => (
                <div class="absolute rounded-full border border-[#0e1a35]/[0.07]" style={`width:${s * 4}px;height:${s * 4}px`} />
              ))}
              <div class="absolute h-px w-full bg-[#0e1a35]/[0.05]" />
              <div class="absolute h-full w-px bg-[#0e1a35]/[0.05]" />
              <div class="animate-sweep absolute h-80 w-80 rounded-full motion-reduce:animate-none" style="background:conic-gradient(from 0deg,rgba(240,96,60,.24) 0deg,rgba(240,96,60,0) 70deg,transparent 360deg)" />
            </div>
            <ul class="relative z-10 my-auto flex flex-col gap-3">
              {blips.map((d, i) => (
                <li class:list={['shadow-lift flex max-w-[92%] items-center gap-2.5 rounded-xl bg-white/95 p-2.5 backdrop-blur-sm', i === 0 ? 'self-start' : i === 1 ? 'self-end' : 'self-center']}>
                  <Monogram name={m(d.data.merchant).data.name} size="xs" />
                  <a href={`/deals/${d.id}/`} class="min-w-0 no-underline">
                    <span class="text-ink tabular block truncate text-[0.82rem] font-bold">
                      {getHeadline(d.data).value} · {m(d.data.merchant).data.name}
                    </span>
                    <span class="text-muted block truncate text-[0.72rem]">{programShortName[d.data.offerType]}</span>
                  </a>
                  <Icon name="radar" class="text-accent-strong h-4 w-4 shrink-0" />
                </li>
              ))}
            </ul>
            <div class="bg-shell relative z-10 flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-[0.78rem]">
              <span class="text-ink flex items-center gap-1.5 font-semibold"><Icon name="check-circle" class="text-positive h-4 w-4" /> Fine print on every offer</span>
              {latestCheck && <span class="text-muted">Last checked {formatDate(latestCheck)}</span>}
            </div>
          </div>
        </div>
      )
    }
  </section>

  <!-- Trust strip -->
  <section class="bg-shell" aria-label="How we work">
    <ul class="container-page grid grid-cols-2 gap-4 py-6 md:grid-cols-4">
      {
        [
          { icon: 'receipt', title: `${active.length} active offers`, text: 'Confirmed on each store’s own site' },
          { icon: 'store', title: `${storesWithOffers} stores covered`, text: 'Policies linked to their sources' },
          { icon: 'list', title: 'Fine print first', text: 'Who qualifies, before you click' },
          { icon: 'clock', title: 'No fake urgency', text: 'No countdown clocks, ever' },
        ].map((t) => (
          <li class="flex items-center gap-3">
            <span class="text-accent-strong flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white"><Icon name={t.icon} class="h-5 w-5" /></span>
            <span class="min-w-0">
              <span class="text-ink block text-sm font-bold">{t.title}</span>
              <span class="text-ink-2 block text-[0.82rem] leading-snug">{t.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    featured.length > 0 && (
      <section class="container-page pt-16" aria-labelledby="featured">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow">Editor selection</p>
            <h2 id="featured" class="display mt-1 text-[2.25rem] leading-tight font-semibold">Worth checking first</h2>
          </div>
          <p class="text-ink-2 max-w-md text-[0.95rem]">Standing programs with real, recurring savings that eligible shoppers often overlook.</p>
        </div>
        <div class="mt-7 grid gap-5 md:grid-cols-2">
          {featured.map((d) => <FeatureDealCard deal={d} merchant={m(d.data.merchant)} />)}
        </div>
      </section>
    )
  }

  {
    programs.length > 0 && (
      <section class="container-page pt-20" aria-labelledby="browse">
        <p class="eyebrow">Eligibility</p>
        <h2 id="browse" class="display mt-1 text-[2.25rem] leading-tight font-semibold">Find savings by who you are</h2>
        <p class="text-ink-2 mt-2 max-w-2xl">Many stores offer standing discounts based on your status. Start with the programs you qualify for.</p>
        <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
          {programs.map((p, i) => {
            const st = programStyle[p.slug];
            const names = programStores(p.slug);
            return (
              <a href={`/discounts/${p.slug}/`} class:list={['group card-hover flex flex-col rounded-[var(--radius-card)] p-6 no-underline', st.tint, i < 3 ? 'lg:col-span-2' : 'lg:col-span-3']} data-track="Category Select" data-track-props={JSON.stringify({ category: `program:${p.slug}`, placement: 'home-bento' })}>
                <span class="flex items-center justify-between">
                  <Icon name={st.icon} class={`h-7 w-7 ${st.text}`} />
                  <span class:list={['pill bg-white', st.text]}>{p.deals.length} {p.deals.length === 1 ? 'offer' : 'offers'}</span>
                </span>
                <span class="display text-ink mt-5 block text-[1.6rem] leading-tight font-medium">{programShortName[p.slug]}</span>
                <span class="text-ink-2 mt-2 block text-[0.9rem] leading-relaxed">{p.description}</span>
                <span class:list={['mt-auto flex items-center justify-between gap-3 pt-5 text-[0.8rem] font-bold', st.text]}>
                  <span class="truncate">{names.slice(0, 3).join(', ')}{names.length > 3 ? ` +${names.length - 3}` : ''}</span>
                  <Icon name="arrow" class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5" />
                </span>
              </a>
            );
          })}
        </div>
        {
          cats.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-2">
              <span class="text-faint mr-1 text-[0.7rem] font-bold tracking-[0.12em] uppercase">Or by category</span>
              {cats.map((c) => (
                <a href={`/categories/${c.slug}/`} class="chip" data-track="Category Select" data-track-props={JSON.stringify({ category: c.slug, placement: 'home-categories' })}>
                  <Icon name={c.icon} class="h-4 w-4" /> {c.name}
                </a>
              ))}
            </div>
          )
        }
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="container-page pt-20" aria-labelledby="recent" data-radar-feed>
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow">Recently added</p>
            <h2 id="recent" class="display mt-1 text-[2.25rem] leading-tight font-semibold">New on the radar</h2>
          </div>
          {recentTypes.length > 1 && (
            <div class="bg-shell flex flex-wrap gap-1 rounded-full p-1" role="group" aria-label="Filter recent offers">
              <button type="button" class="chip !min-h-8 !bg-transparent !px-3.5 !text-[0.8rem] aria-pressed:!bg-ink aria-pressed:!text-white" aria-pressed="true" data-radar-tab="">All</button>
              {recentTypes.map((p) => (
                <button type="button" class="chip !min-h-8 !bg-transparent !px-3.5 !text-[0.8rem] aria-pressed:!bg-ink aria-pressed:!text-white" aria-pressed="false" data-radar-tab={p.slug}>
                  {p.label === 'Free trial' ? 'Trials' : p.label}
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="mt-7 grid gap-4 md:grid-cols-2">
          {recent.map((d) => <DealRow deal={d} merchant={m(d.data.merchant)} />)}
        </div>
        <div class="mt-8 text-center">
          <a href="/deals/" class="btn-ghost">See all {active.length} deals <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      </section>
    )
  }

  {
    picks.length > 0 && (
      <section class="bg-ink mt-20 text-white" aria-labelledby="picks">
        <div class="container-page py-16">
          <p class="text-accent text-xs font-semibold tracking-[0.12em] uppercase">Editor’s picks</p>
          <h2 id="picks" class="display mt-1 text-[2.25rem] leading-tight font-semibold !text-white">Savings people often miss</h2>
          <p class="mt-3 max-w-xl text-white/70">Programs that don’t get much attention on store homepages, and why they’re worth a look.</p>
          <div class="mt-9 grid gap-5 lg:grid-cols-3">
            {picks.map((d, i) => (
              <article class="bg-navy-card relative flex flex-col rounded-[var(--radius-card)] p-6 ring-1 ring-white/5">
                <span class="bg-accent/15 text-[#ffa58a] flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold">0{i + 1}</span>
                <p class="mt-5 text-sm text-white/60">{m(d.data.merchant).data.name}</p>
                <h3 class="display mt-1 text-[1.5rem] leading-snug font-medium !text-white">
                  <a href={`/deals/${d.id}/`} class="after:absolute after:inset-0 hover:underline decoration-1 underline-offset-4">{d.data.title}</a>
                </h3>
                <p class="mt-3 line-clamp-5 text-[0.92rem] leading-relaxed text-white/75">{firstParagraph(d.data.editorialSummary)}</p>
                <p class="text-accent mt-auto flex items-center gap-1.5 pt-5 text-sm font-semibold">Read the details <Icon name="arrow" class="h-4 w-4" /></p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    storeRows.length > 0 && (
      <section class="container-page pt-20" aria-labelledby="stores">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow">Stores</p>
            <h2 id="stores" class="display mt-1 text-[2.25rem] leading-tight font-semibold">Stores we cover</h2>
          </div>
          <p class="text-ink-2 max-w-md text-[0.95rem]">Each store page lists its active offers plus shipping and return rules, with sources.</p>
        </div>
        <ul class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {storeRows.map((s) => (
            <li>
              <a href={`/stores/${s.merchant.id}/`} class="card card-hover flex h-full flex-col items-center px-3 py-5 text-center no-underline">
                <Monogram name={s.merchant.data.name} />
                <span class="text-ink mt-3 text-sm font-semibold">{s.merchant.data.name}</span>
                <span class="text-muted text-xs">{s.count} active {s.count === 1 ? 'offer' : 'offers'}</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/stores/" class="bg-shell hover:bg-sand flex h-full flex-col items-center justify-center rounded-[var(--radius-card)] px-3 py-5 text-center no-underline">
              <Icon name="plus" class="text-ink-2 h-6 w-6" />
              <span class="text-ink mt-2 text-sm font-semibold">All stores</span>
              <span class="text-muted text-xs">Policies & tips</span>
            </a>
          </li>
        </ul>
      </section>
    )
  }

  <AdSlot id="home-mid" />

  <!-- How it works -->
  <section class="bg-shell mt-20" aria-labelledby="how">
    <div class="container-page py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">How it works</p>
        <h2 id="how" class="display mt-1 text-[2.25rem] leading-tight font-semibold">A deal site that shows its work</h2>
        <p class="text-ink-2 mt-3">No giveaways, countdown timers, or “only 2 left” banners — just offers we can confirm, with the catch written down.</p>
      </div>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {
          [
            { title: 'We check the official terms', text: 'We confirm each offer on the store’s own pages — not coupon aggregators — and link the source.' },
            { title: 'We write down the catch', text: 'Who qualifies, what’s excluded, when it renews, and the date we last checked it.' },
            { title: 'You go straight to the store', text: 'One button opens the store. Some links may earn us a commission; it never changes your price.' },
          ].map((s, i) => (
            <li class="card p-7">
              <span class="display text-accent-strong text-5xl font-semibold">0{i + 1}</span>
              <h3 class="display text-ink mt-4 text-[1.5rem] leading-snug font-medium">{s.title}</h3>
              <p class="text-ink-2 mt-2 text-[0.95rem] leading-relaxed">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-center"><a href="/how-we-find-deals/" class="link">How we find deals →</a></p>
    </div>
  </section>

  {
    guides.length > 0 && (
      <section class="container-page pt-20" aria-labelledby="guides">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Shopping guides</p>
            <h2 id="guides" class="display mt-1 text-[2.25rem] leading-tight font-semibold">Shop smarter, avoid the traps</h2>
          </div>
          <a href="/guides/" class="link hidden text-sm sm:inline">All guides →</a>
        </div>
        <div class="mt-7 grid gap-5 md:grid-cols-3">
          {guides.slice(0, 3).map((g) => <GuideCard guide={g} />)}
        </div>
      </section>
    )
  }

  <!-- Newsletter -->
  <section class="container-page pt-20" aria-labelledby="newsletter">
    <div class="bg-ink shadow-float relative overflow-hidden rounded-[28px] px-6 py-10 sm:px-12 sm:py-14">
      <svg aria-hidden="true" viewBox="0 0 200 200" class="pointer-events-none absolute -right-36 -bottom-44 h-[26rem] w-[26rem] opacity-20">
        <circle cx="100" cy="100" r="96" fill="none" stroke="#fff" stroke-width=".8"></circle>
        <circle cx="100" cy="100" r="66" fill="none" stroke="#fff" stroke-width=".8"></circle>
        <circle cx="100" cy="100" r="34" fill="none" stroke="#f0603c" stroke-width="1"></circle>
      </svg>
      <div class="relative grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        <div>
          <p class="bg-accent/15 text-[#ffa58a] inline-flex items-center gap-2 rounded-full px-3 py-1 text-[0.7rem] font-bold tracking-[0.1em] uppercase">
            <Icon name="mail" class="h-3.5 w-3.5" /> No spam
          </p>
          <h2 id="newsletter" class="display mt-4 text-[2.25rem] leading-tight font-semibold !text-white">Get checked offers by email</h2>
          <p class="mt-3 max-w-md leading-relaxed text-white/75">A short, plain email with offers we’ve checked and guides worth reading. At most once a week.</p>
        </div>
        <NewsletterForm idPrefix="home-nl" />
      </div>
    </div>
  </section>

  <script>
    // "New on the radar" type tabs
    const root = document.querySelector<HTMLElement>('[data-radar-feed]');
    const tabs = root?.querySelectorAll<HTMLButtonElement>('[data-radar-tab]') ?? [];
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        const type = tab.dataset.radarTab ?? '';
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        root?.querySelectorAll<HTMLElement>('[data-row-type]').forEach((row) => {
          const expired = row.dataset.expires && Date.parse(row.dataset.expires) < Date.now();
          row.hidden = Boolean(expired) || (type !== '' && row.dataset.rowType !== type);
        });
      }),
    );
  </script>
</BaseLayout>
