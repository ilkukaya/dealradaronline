---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealCard from '../../components/deals/DealCard.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import Monogram from '../../components/ui/Monogram.astro';
import Icon from '../../components/ui/Icon.astro';
import { categories, offerTypes } from '../../config/taxonomy';
import { programShortName, programStyle } from '../../config/styles';
import { getActiveDeals, getMerchantMap } from '../../lib/catalog';
import { formatDate } from '../../lib/deal-utils';

const [deals, merchantMap] = await Promise.all([getActiveDeals(), getMerchantMap()]);
const m = (id: string) => merchantMap.get(id)!;
const count = (pred: (d: (typeof deals)[number]) => boolean) => deals.filter(pred).length;

const usedTypes = offerTypes.filter((t) => deals.some((d) => d.data.offerType === t.slug));
const usedCats = categories.filter((c) => deals.some((d) => d.data.category === c.slug));
const usedStores = [...new Set(deals.map((d) => d.data.merchant))].map(m).sort((a, b) => a.data.name.localeCompare(b.data.name));
const hasPrices = deals.some((d) => d.data.price !== undefined);
const hasDiscounts = deals.some((d) => d.data.referencePrice !== undefined || d.data.statedPercentOff !== undefined);
const latestCheck = deals.length ? new Date(Math.max(...deals.map((d) => d.data.lastVerified.getTime()))) : undefined;
const PAGE_SIZE = 24;
---

<BaseLayout
  title="All Deals, Discounts & Offers"
  description="Every active offer we track from US stores — student and military discounts, free trials, free shipping, and promo codes — with the fine print."
  canonicalPath="/deals/"
>
  <div class="container-page pt-8 pb-6 sm:pt-10">
    <Breadcrumbs items={[{ name: 'Deals', href: '/deals/' }]} />
    <p class="bg-accent-soft text-accent-deep mt-5 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[0.72rem] font-bold tracking-[0.08em] uppercase">
      <span class="bg-accent-strong h-2 w-2 rounded-full"></span>
      {deals.length} active offers{latestCheck ? ` · last checked ${formatDate(latestCheck)}` : ''}
    </p>
    <h1 class="display mt-3 text-[2.75rem] leading-none font-semibold sm:text-[3.5rem]">All deals</h1>
    <p class="text-ink-2 mt-4 max-w-2xl text-lg leading-relaxed">
      Standing discounts, student and military pricing, free trials, and shipping perks — each with who qualifies, the main restrictions, and when we last checked it.
    </p>
  </div>

  <div class="container-page border-line border-t pt-8 pb-4" data-deal-browser data-page-size={PAGE_SIZE}>
    <div class="grid gap-6 lg:grid-cols-[272px_minmax(0,1fr)] lg:gap-8">
      <!-- Filters -->
      <div>
        <button type="button" class="btn-ghost w-full lg:hidden" data-filter-toggle aria-expanded="false" aria-controls="filter-panel">
          <Icon name="filter" class="h-4 w-4" /> Filters <span class="bg-ink hidden rounded-full px-2 py-0.5 text-xs text-white" data-filter-count></span>
        </button>
        <form id="filter-panel" class="card mt-3 hidden p-5 lg:sticky lg:top-36 lg:mt-0 lg:block" role="search" aria-label="Filter deals" data-filter-form onsubmit="return false">
          <div class="flex items-center justify-between">
            <p class="display text-ink flex items-center gap-2 text-xl font-semibold"><Icon name="filter" class="text-accent-strong h-5 w-5" /> Filters</p>
            <button type="button" class="text-accent-deep text-sm font-semibold underline underline-offset-2" data-clear-filters>Clear all</button>
          </div>
          <label for="f-q" class="sr-only">Search offers</label>
          <div class="relative mt-4">
            <Icon name="search" class="text-faint pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2" />
            <input id="f-q" name="q" type="search" class="bg-shell focus:ring-ink/15 h-11 w-full rounded-full pr-4 pl-10 text-sm outline-none focus:bg-white focus:ring-2" placeholder="Store, offer, or keyword" autocomplete="off" />
          </div>

          <div class="border-line mt-5 border-t pt-5"><fieldset>
            <legend class="text-ink-2 text-[0.72rem] font-bold tracking-[0.12em] uppercase">Discount type</legend>
            <ul class="mt-3 space-y-1">
              {
                usedTypes.map((t) => (
                  <li>
                    <label class="hover:bg-shell flex cursor-pointer items-center gap-2.5 rounded-lg px-1.5 py-1.5 text-[0.92rem]">
                      <input type="checkbox" name="type" value={t.slug} class="accent-accent-strong h-4 w-4 rounded" />
                      <Icon name={programStyle[t.slug].icon} class={`h-4 w-4 ${programStyle[t.slug].text}`} />
                      <span class="text-ink flex-1">{programShortName[t.slug]}</span>
                      <span class="bg-shell text-muted rounded-full px-2 text-xs font-semibold">{count((d) => d.data.offerType === t.slug)}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset></div>

          <div class="border-line mt-5 border-t pt-5"><fieldset>
            <legend class="text-ink-2 text-[0.72rem] font-bold tracking-[0.12em] uppercase">Category</legend>
            <ul class="mt-3 space-y-1">
              {
                usedCats.map((c) => (
                  <li>
                    <label class="hover:bg-shell flex cursor-pointer items-center gap-2.5 rounded-lg px-1.5 py-1.5 text-[0.92rem]">
                      <input type="checkbox" name="category" value={c.slug} class="accent-accent-strong h-4 w-4 rounded" />
                      <span class="text-ink flex-1">{c.name}</span>
                      <span class="bg-shell text-muted rounded-full px-2 text-xs font-semibold">{count((d) => d.data.category === c.slug)}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset></div>

          <div class="border-line mt-5 border-t pt-5"><fieldset>
            <legend class="text-ink-2 text-[0.72rem] font-bold tracking-[0.12em] uppercase">Store</legend>
            <ul class="mt-3 space-y-1">
              {
                usedStores.map((s) => (
                  <li>
                    <label class="hover:bg-shell flex cursor-pointer items-center gap-2.5 rounded-lg px-1.5 py-1 text-[0.92rem]">
                      <input type="checkbox" name="store" value={s.id} class="accent-accent-strong h-4 w-4 rounded" />
                      <Monogram name={s.data.name} id={s.id} size="xs" />
                      <span class="text-ink flex-1">{s.data.name}</span>
                      <span class="text-muted text-xs">{count((d) => d.data.merchant === s.id)}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset></div>
        </form>
      </div>

      <!-- Results -->
      <div class="min-w-0">
        <div class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex min-w-0 flex-wrap items-center gap-2">
            <p class="text-ink flex items-center gap-2 text-sm font-semibold" aria-live="polite">
              <span class="bg-positive h-2 w-2 rounded-full"></span>
              <span data-result-count>Showing {deals.length} {deals.length === 1 ? 'offer' : 'offers'}</span>
            </p>
            <div class="flex flex-wrap gap-1.5" data-active-filters></div>
          </div>
          <div class="flex items-center gap-2">
            <label for="f-sort" class="text-muted text-sm whitespace-nowrap">Sort by</label>
            <select id="f-sort" name="sort" form="filter-panel" class="bg-shell text-ink h-10 rounded-full border-0 px-4 text-sm font-semibold">
              <option value="newest">Newest first</option>
              {hasPrices && <option value="price-asc">Price: low to high</option>}
              {hasPrices && <option value="price-desc">Price: high to low</option>}
              {hasDiscounts && <option value="discount">Biggest discount</option>}
            </select>
          </div>
        </div>

        {
          deals.length > 0 && (
            <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-deal-grid>
              {deals.map((d) => (
                <DealCard deal={d} merchant={m(d.data.merchant)} headingLevel="h2" />
              ))}
            </div>
          )
        }

        <div class="card mt-5 px-6 py-14 text-center" data-empty-state hidden={deals.length > 0}>
          <Icon name="radar" class="text-accent-strong mx-auto h-10 w-10" />
          <h2 class="display mt-4 text-2xl font-semibold">No offers match those filters</h2>
          <p class="text-ink-2 mx-auto mt-2 max-w-md">
            Try a broader search, or browse our <a href="/guides/" class="link">shopping guides</a> while we add more offers.
          </p>
          <button type="button" class="btn-ghost mt-6" data-clear-filters-empty>Clear filters</button>
        </div>

        <div class="mt-8 text-center" data-load-more-wrap hidden>
          <button type="button" class="btn-ghost" data-load-more>Show more offers</button>
        </div>

        <p class="text-muted mt-10 text-center text-sm">
          Expired offers are removed from this list automatically. <a href="/how-we-find-deals/" class="link">How we find and check deals</a>.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { initDealBrowser } from '../../scripts/deal-browser';
    initDealBrowser();
  </script>
</BaseLayout>
