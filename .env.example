# DealRadar Online — environment variables
# Copy to .env for local development. In production, set these in
# Netlify → Site configuration → Environment variables.
# PUBLIC_* values are embedded in the public HTML: never put secrets in them.

# ── Site & brand (all optional; defaults live in src/config/site.ts) ──────────
PUBLIC_SITE_URL=https://dealradaronline.com
# PUBLIC_SITE_NAME=DealRadar Online
# PUBLIC_SITE_SHORT_NAME=DealRadar
# PUBLIC_SITE_TAGLINE=Discover Deals. Save More.
# PUBLIC_FOUNDED_YEAR=2026

# ── Owner details (shown on legal pages only when set) ────────────────────────
# PUBLIC_OWNER_LEGAL_NAME=Jane Doe            # or your registered business name
# PUBLIC_OWNER_JURISDICTION=the State of Delaware
# PUBLIC_CONTACT_EMAIL=hello@dealradaronline.com
# PUBLIC_MAILING_ADDRESS=PO Box 123, City, ST 00000   # required before sending newsletters (CAN-SPAM)

# ── Social profiles (only set once the profile exists) ───────────────────────
# PUBLIC_SOCIAL_PINTEREST=https://www.pinterest.com/...
# PUBLIC_SOCIAL_X=https://x.com/...
# PUBLIC_SOCIAL_FACEBOOK=
# PUBLIC_SOCIAL_INSTAGRAM=
# PUBLIC_SOCIAL_THREADS=

# ── Search engine / network site verification (meta tags) ─────────────────────
# PUBLIC_GOOGLE_SITE_VERIFICATION=
# PUBLIC_BING_SITE_VERIFICATION=
# PUBLIC_PINTEREST_SITE_VERIFICATION=
# PUBLIC_IMPACT_SITE_VERIFICATION=

# ── Analytics (optional, cookieless) ─────────────────────────────────────────
# PUBLIC_PLAUSIBLE_DOMAIN=dealradaronline.com
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.outbound-links.js
# PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# First-party outbound click counter (Netlify Function). Set to "off" to disable.
# PUBLIC_CLICK_ENDPOINT=/api/out

# ── Newsletter ────────────────────────────────────────────────────────────────
# netlify (default waitlist via Netlify Forms) | buttondown | mailerlite
# PUBLIC_NEWSLETTER_PROVIDER=netlify
# PUBLIC_BUTTONDOWN_USERNAME=
# PUBLIC_MAILERLITE_FORM_ACTION=

# ── Site-wide link monetization (ONLY after the network approves the site) ───
# Use one, never both.
# PUBLIC_SKIMLINKS_PUBLISHER_ID=
# PUBLIC_SOVRN_COMMERCE_KEY=

# ── Advertising (keep false until an ad network approves the site) ───────────
# PUBLIC_ADS_ENABLED=false

# ── Development only ─────────────────────────────────────────────────────────
# Show sample (fake) deals locally. Never enable in production.
# PUBLIC_SHOW_FIXTURES=true

# ── Server-side secrets (Netlify Functions scope; NOT PUBLIC_) ───────────────
# BUILD_HOOK_URL=            # Netlify build hook for the daily expiry rebuild
# CLICK_STATS_TOKEN=         # long random string; protects /api/out-stats

# Affiliate network API credentials (used by src/lib/affiliate adapters, never in the browser)
# FLEXOFFERS_API_KEY=
# FLEXOFFERS_DOMAIN_ID=
# CJ_PERSONAL_ACCESS_TOKEN=
# CJ_COMPANY_ID=
# CJ_WEBSITE_ID=
# AWIN_API_TOKEN=
# AWIN_PUBLISHER_ID=
